<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:HNReader.Avalonia.Controls"
        x:Class="HNReader.Avalonia.MainWindow"
        Icon="avares://HNReader.Avalonia/Assets/HnReaderIcon.ico"
        Title="HN Reader"
        Width="1280" Height="820"
        MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource HnPageBackgroundBrush}"
        UseLayoutRounding="True"
        RenderOptions.TextRenderingMode="SubpixelAntialias"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="-1">

    <!-- No title-bar band: the client area extends into it and Windows draws the
         caption buttons over the top right. Title is kept because it feeds the
         taskbar and Alt-Tab, not because anything renders it.

         Width/Height are DIPs and only a request - App clamps them to the
         screen's working area before the window is shown, because a fixed size
         in DIPs overflows any display running above 100% scaling.

         Deliberately opaque, with no TransparencyLevelHint: text composited over
         a translucent backdrop cannot use subpixel antialiasing and loses
         contrast against whatever sits behind the window. -->
    <!-- OffScreenMargin is non-zero only while maximised, and is exactly the
         slice of the window that falls outside the screen: with the client area
         extended into the decorations, a maximised window overhangs every edge by
         the invisible resize border, which pushed the nav items hard against the
         screen edge. Binding it here needs no WindowState handler and no
         hard-coded border width. -->
    <Grid Margin="{Binding OffScreenMargin, RelativeSource={RelativeSource AncestorType=Window}}"
          ColumnDefinitions="Auto,*" RowDefinitions="Auto,*">

        <!-- Spans both rows so the pane still runs the full height of the window;
             only the content column sits below the caption strip. -->
        <c:NavigationPane x:Name="NavPane" Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" />

        <!-- Stands in for the title bar that is no longer there: without it the
             window could only be moved by its edges. -->
        <Border x:Name="TitleStrip"
                Grid.Column="1"
                Grid.Row="0"
                Height="32"
                Background="Transparent"
                PointerPressed="OnTitleStripPointerPressed"
                DoubleTapped="OnTitleStripDoubleTapped" />

        <!-- ClipToBounds matters during the transition: the outgoing and incoming
             pages would otherwise paint outside their slot. -->
        <TransitioningContentControl x:Name="ContentHost"
                                     Grid.Column="1"
                                     Grid.Row="1"
                                     ClipToBounds="True"
                                     Background="{DynamicResource HnPageBackgroundBrush}">
            <TransitioningContentControl.PageTransition>
                <!-- A cross-fade, not a slide: PageSlide translates by the full
                     control extent, which on a wide window is a long sweep of a
                     heavy story list. Keep the duration at or below
                     NavigationService.TeardownDelay. -->
                <CrossFade Duration="0:0:0.18" />
            </TransitioningContentControl.PageTransition>
        </TransitioningContentControl>
    </Grid>
</Window>
