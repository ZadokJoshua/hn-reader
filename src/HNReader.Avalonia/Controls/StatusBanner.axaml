<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:HNReader.Avalonia.Controls"
             x:Class="HNReader.Avalonia.Controls.StatusBanner"
             x:Name="Root">

    <UserControl.Styles>
        <!-- Severity drives colour through pseudoclasses set in the code-behind,
             so a call site only ever sets Severity and never a brush. -->
        <Style Selector="c|StatusBanner Border#PART_Root">
            <Setter Property="Background" Value="{DynamicResource HnInfoBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HnInfoBrush}" />
        </Style>
        <Style Selector="c|StatusBanner:success Border#PART_Root">
            <Setter Property="Background" Value="{DynamicResource HnSuccessBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HnSuccessBrush}" />
        </Style>
        <Style Selector="c|StatusBanner:warning Border#PART_Root">
            <Setter Property="Background" Value="{DynamicResource HnWarningBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HnWarningBrush}" />
        </Style>
        <Style Selector="c|StatusBanner:error Border#PART_Root">
            <Setter Property="Background" Value="{DynamicResource HnCriticalBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HnCriticalBrush}" />
        </Style>

        <Style Selector="c|StatusBanner c|IconGlyph#PART_Icon">
            <Setter Property="Foreground" Value="{DynamicResource HnInfoBrush}" />
        </Style>
        <Style Selector="c|StatusBanner:success c|IconGlyph#PART_Icon">
            <Setter Property="Foreground" Value="{DynamicResource HnSuccessBrush}" />
        </Style>
        <Style Selector="c|StatusBanner:warning c|IconGlyph#PART_Icon">
            <Setter Property="Foreground" Value="{DynamicResource HnWarningBrush}" />
        </Style>
        <Style Selector="c|StatusBanner:error c|IconGlyph#PART_Icon">
            <Setter Property="Foreground" Value="{DynamicResource HnCriticalBrush}" />
        </Style>

        <!-- Entrance only: a short fade so a result appears rather than pops. The
             "opened" class is set by the code-behind when IsOpen turns true, because
             IsVisible changing does not re-run a style animation by itself. Fade only
             - the banner sits inline, so moving it would nudge the controls around it. -->
        <Style Selector="c|StatusBanner Border#PART_Root.opened">
            <Style.Animations>
                <Animation Duration="0:0:0.2" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <Border x:Name="PART_Root"
            CornerRadius="4"
            BorderThickness="1"
            Padding="12,10"
            IsVisible="{Binding #Root.IsOpen}">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <c:IconGlyph x:Name="PART_Icon"
                         Grid.Column="0"
                         FontSize="16"
                         VerticalAlignment="Top"
                         Margin="0,1,0,0" />

            <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="{Binding #Root.Title}"
                           Classes="BodyStrongTextBlockStyle"
                           TextWrapping="Wrap"
                           IsVisible="{Binding #Root.Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Text="{Binding #Root.Message}"
                           TextWrapping="Wrap"
                           FontSize="13"
                           Foreground="{DynamicResource HnTextSecondaryBrush}"
                           IsVisible="{Binding #Root.Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>

            <Button x:Name="PART_Close"
                    Grid.Column="2"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="6"
                    VerticalAlignment="Top"
                    ToolTip.Tip="Dismiss"
                    IsVisible="{Binding #Root.IsClosable}">
                <c:IconGlyph Glyph="{DynamicResource IconDismiss}" FontSize="12" />
            </Button>
        </Grid>
    </Border>
</UserControl>
