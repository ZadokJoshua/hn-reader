<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:HNReader.Avalonia.Controls"
             x:Class="HNReader.Avalonia.Views.SettingsView">

    <Grid Margin="32,24,32,24">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="24" Width="600" HorizontalAlignment="Left">

                <!-- Page Header -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Settings" Classes="TitleTextBlockStyle" FontWeight="Bold" />
                    <TextBlock Text="Customize your HN Reader experience"
                               Classes="CaptionTextBlockStyle" />
                </StackPanel>

                <!-- Appearance -->
                <Border Classes="SettingsCard">
                    <StackPanel Spacing="20">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Classes="SettingsIconBadge">
                                <c:IconGlyph Glyph="{StaticResource IconTheme}" FontSize="16" Foreground="White" />
                            </Border>
                            <TextBlock Text="Appearance" Classes="SubtitleTextBlockStyle" VerticalAlignment="Center" />
                        </StackPanel>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Theme" Classes="BodyStrongTextBlockStyle" />
                                <TextBlock Text="Select your preferred app theme" Classes="CaptionTextBlockStyle" />
                            </StackPanel>
                            <ComboBox Grid.Column="1"
                                      MinWidth="140"
                                      SelectedIndex="{Binding SelectedThemeIndex, Mode=TwoWay}"
                                      ItemsSource="{Binding ThemeOptions}"
                                      VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Links -->
                <Border Classes="SettingsCard">
                    <StackPanel Spacing="20">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Classes="SettingsIconBadge">
                                <c:IconGlyph Glyph="{StaticResource IconExternal}" FontSize="16" Foreground="White" />
                            </Border>
                            <TextBlock Text="Links" Classes="SubtitleTextBlockStyle" VerticalAlignment="Center" />
                        </StackPanel>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,16,0">
                                <TextBlock Text="Confirm before opening links in comments" Classes="BodyStrongTextBlockStyle" />
                                <TextBlock Text="Shows which site a link goes to before it opens in your browser."
                                           Classes="CaptionTextBlockStyle"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsChecked="{Binding ConfirmCommentLinks, Mode=TwoWay}"
                                          OnContent="" OffContent=""
                                          VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Data & Diagnostics -->
                <Border Classes="SettingsCard">
                    <StackPanel Spacing="20">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Classes="SettingsIconBadge">
                                <c:IconGlyph Glyph="{StaticResource IconData}" FontSize="16" Foreground="White" />
                            </Border>
                            <TextBlock Text="Data" Classes="SubtitleTextBlockStyle" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Backup &amp; restore your favourites" Classes="BodyStrongTextBlockStyle" />
                            <TextBlock Text="Export to a JSON file you can save anywhere, or import a previously-exported file."
                                       Classes="CaptionTextBlockStyle"
                                       TextWrapping="Wrap" />

                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                <Button x:Name="ExportFavoritesButton"
                                        Click="ExportFavoritesButton_Click"
                                        Classes="accent">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <c:IconGlyph Glyph="{StaticResource IconExport}" FontSize="14" />
                                        <TextBlock Text="Export favourites" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ImportFavoritesButton"
                                        Click="ImportFavoritesButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <c:IconGlyph Glyph="{StaticResource IconImport}" FontSize="14" />
                                        <TextBlock Text="Import favourites" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <c:StatusBanner x:Name="StatusBannerControl"
                                        IsOpen="False"
                                        IsClosable="True"
                                        Margin="0,8,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- About -->
                <Border Classes="SettingsCard">
                    <StackPanel Spacing="8">
                        <TextBlock Text="About" Classes="SubtitleTextBlockStyle" />
                        <TextBlock Text="HN Reader" Classes="BodyStrongTextBlockStyle" />
                        <TextBlock Text="A fast, modern Hacker News reader. Browse stories, read full comment threads, and save your favourites."
                                   Classes="CaptionTextBlockStyle"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
