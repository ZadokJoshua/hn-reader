<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:HNReader.Avalonia.Converters"
             x:Class="HNReader.Avalonia.App"
             RequestedThemeVariant="Default"
             Name="HN Reader">

    <Application.DataTemplates>
    </Application.DataTemplates>

    <!-- Order matters: the theme first, the app's class styles second. Reversed,
         the theme's control defaults win over the app's own styles wherever the
         two set the same property. -->
    <Application.Styles>
        <FluentTheme>
            <!-- Pins the accent so the app looks the same regardless of the OS
                 accent-colour setting. Palettes rather than hand-written
                 SystemAccentColorLight1..3/Dark1..3: ColorPaletteResources
                 regenerates those shades per variant with the theme's own
                 algorithm, and it is what actually reaches ToggleSwitch,
                 CheckBox, Slider, TextBox focus and list selection. -->
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light" Accent="#FFFF6600" />
                <ColorPaletteResources x:Key="Dark" Accent="#FFFF6600" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://HNReader.Avalonia/Styles/Resources.axaml" />
        <StyleInclude Source="avares://HNReader.Avalonia/Styles/MarkdownLinks.axaml" />
        <StyleInclude Source="avares://HNReader.Avalonia/Styles/MarkdownComments.axaml" />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://HNReader.Avalonia/Styles/Icons.axaml" />
                <ResourceInclude Source="avares://HNReader.Avalonia/Styles/Tokens.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Phosphor icon font. The "#Phosphor" suffix must match the family name
                 recorded inside the .ttf; get it wrong and glyphs silently render as
                 blank boxes rather than raising an error. -->
            <FontFamily x:Key="PhosphorFont">avares://HNReader.Avalonia/Assets/fonts/Phosphor.ttf#Phosphor</FontFamily>


            <!-- Brand plumbing for the STOCK control themes.
                 The app's own colours all live in Styles/Tokens.axaml; the keys
                 below exist only to push the brand into controls the app does not
                 template itself (accent Button, ToggleSwitch, CheckBox, the toast
                 card). They are deliberately named after the theme that consumes
                 them - they are an adapter, not part of the app's palette.

                 SystemAccentColor is kept as a belt-and-braces for anything that
                 reads the raw colour; the per-variant shades are generated by
                 FluentTheme.Palettes in Application.Styles rather than hand-written. -->
            <Color x:Key="SystemAccentColor">#FFFF6600</Color>

            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FFFF6600" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FFFF6600" Opacity="0.9" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#FFFF6600" Opacity="0.8" />
            <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#FFFF6600" Opacity="0.4" />

            <!-- Accent as TEXT, so these take the AA-contrast variant rather than
                 the raw brand hue (see HnAccentTextBrush in Tokens.axaml). -->
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FFB34700" />
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#FFB34700" Opacity="0.9" />
            <SolidColorBrush x:Key="AccentTextFillColorDisabledBrush" Color="#FFB34700" Opacity="0.4" />

            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#FFFFFFFF" Opacity="0.9" />
            <SolidColorBrush x:Key="TextOnAccentFillColorDisabledBrush" Color="#FFFFFFFF" Opacity="0.7" />

            <!-- Recolor the built-in toast notification's top accent stripe so
                 confirmations (copy/favourite) rhyme with the brand instead of
                 Avalonia's default green/blue. Warning/Error stay semantic.
                 These two belong to Avalonia's own NotificationCard, not to any
                 third-party theme, so they outlive the FluentAvalonia removal. -->
            <SolidColorBrush x:Key="NotificationCardSuccessBackgroundBrush" Color="#FFFF6600" />
            <SolidColorBrush x:Key="NotificationCardInformationBackgroundBrush" Color="#FFFF6600" />

            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <conv:BoolToCollapseTextConverter x:Key="BoolToCollapseTextConverter" />
            <conv:DepthToVisibilityConverter x:Key="DepthToVisibilityConverter" />
            <conv:DepthToMarginConverter x:Key="DepthToMarginConverter" />
            <conv:RelativeTimeConverter x:Key="RelativeTimeConverter" />
            <conv:HighlightBorderBrushConverter x:Key="HighlightBorderBrushConverter" />
            <conv:HighlightBorderThicknessConverter x:Key="HighlightBorderThicknessConverter" />
            <conv:StringToUriConverter x:Key="StringToUriConverter" />
            <conv:BoolToOpacityConverter x:Key="BoolToOpacityConverter" />
            <conv:BoolToDimOpacityConverter x:Key="BoolToDimOpacityConverter" />
            <conv:FaviconHostToSourceConverter x:Key="FaviconHostToSourceConverter" />
            <conv:IsNullConverter x:Key="IsNullConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
