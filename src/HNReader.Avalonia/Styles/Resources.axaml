<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:FluentAvalonia.UI.Controls">

    <Style Selector="TextBlock.TitleTextBlockStyle">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.SubtitleTextBlockStyle">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.BodyStrongTextBlockStyle">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.CaptionTextBlockStyle">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- Settings page cards -->
    <Style Selector="Border.SettingsCard">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="24" />
    </Style>

    <Style Selector="Border.SettingsIconBadge">
        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8" />
    </Style>

    <!-- StoriesPageControl / comment tree styles -->
    <Style Selector="Border.CardBorderStyle">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style Selector="Border.CommentCardBorderStyle">
        <Setter Property="Padding" Value="12" />
        <Setter Property="Margin" Value="0,6,0,2" />
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Button.CollapseButtonStyle">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style Selector="Button.ActionButtonStyle">
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <!-- Hover lift for the icon-bearing buttons. The neutral scale(1) has to be declared
         or the transition has nothing to animate from and the first hover snaps. 1.06,
         not the more common 1.1: these sit in a dense list and a larger scale visibly
         nudges the rows around them. -->
    <Style Selector="Button.ActionButtonStyle, Button.CollapseButtonStyle">
        <Setter Property="RenderTransform" Value="scale(1)" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut" />
                <BrushTransition Property="Background" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.ActionButtonStyle:pointerover, Button.CollapseButtonStyle:pointerover">
        <Setter Property="RenderTransform" Value="scale(1.06)" />
    </Style>

    <!-- The story detail pane's URL. Only the pointer is changed: a hand belongs
         on a link, while the action-row buttons keep the standard arrow. The
         .hyperlink class came over from the WinUI port and matched nothing until
         this block, so this selector is the sole thing it drives. -->
    <Style Selector="Button.hyperlink">
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="TextBlock.MetaText">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Every Phosphor glyph in the app. FontSize is set explicitly because FAFontIcon,
         unlike FASymbolIcon, declares no 18px default - without this it would inherit the
         ambient ~14 and icons would quietly change size. Call sites override as needed. -->
    <Style Selector="ui|FontIcon">
        <!-- DynamicResource, not Static: this file is a StyleInclude in
             Application.Styles, which is built before Application.Resources exists,
             so a static lookup here cannot see PhosphorFont. -->
        <Setter Property="FontFamily" Value="{DynamicResource PhosphorFont}" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <!-- Dimmed 12px glyph for story/digest meta rows (author, time, comment count). -->
    <Style Selector="ui|FontIcon.MetaIcon">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style Selector="Border.ScoreBadge">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="8,6" />
    </Style>

    <!-- The pane's section labels ("Browse", "Personal"). FluentAvaloniaUI already
         sets NavigationViewItem itself to FontWeight Normal, so the items were never
         bold - only these headers are, and the weight does NOT live on the header
         control. Its template renders a TextBlock#HeaderText carrying an explicit
         Theme (NavigationViewItemHeaderTextStyle, SemiBold), and an explicit Theme
         beats inheritance - so a Setter on ui|NavigationViewItemHeader silently does
         nothing. The template selector below is what actually reaches the text.
         Dropped to Normal at caption size so the headers read as quiet dividers
         rather than competing with the items they group. -->
    <Style Selector="ui|NavigationViewItemHeader /template/ TextBlock#HeaderText">
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

</Styles>
