{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OpenAI": {
    "Model": "gpt-4o-mini"
  },
  "Digest": {
    "AlgoliaLookbackHours": 24,
    "MinPoints": 0,
    "MaxCandidatePoolSize": 100,
    "ClassificationBatchSize": 25,
    "MaxItemsPerCategory": 8,
    "MaxParallelCategories": 3,
    "MaxScrapeCallsPerCategory": 2,
    "MaxCommentCallsPerCategory": 3,
    "MaxConcurrentCommentFetches": 2,
    "StorySummaryCacheDays": 14,
    "EnablePreviewImages": true,
    "MaxParallelImageFetches": 8,
    "CronSchedule": "0 0 * * *"
  },
  "Storage": {
    "DataDirectory": "data"
  }
}
