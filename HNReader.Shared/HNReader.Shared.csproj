<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0, not net10.0: this assembly is the client/server contract, and the
         Avalonia/WinUI/Core projects all target net8.0. The net10.0 server can
         reference a net8.0 library; the reverse is impossible. Single-target
         deliberately — multi-targeting would double the build output to serve a
         consumer that doesn't exist. -->
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- No PackageReferences, by design. Every client references this, so it must
       stay free of MVVM, HttpClient, and storage dependencies: it carries the
       wire shape and nothing else. Observable/UI-facing models belong in
       HNReader.Core; storage entities stay in the server. -->

</Project>
