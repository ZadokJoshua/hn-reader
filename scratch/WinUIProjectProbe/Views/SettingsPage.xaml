<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HNReader.WinUI.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:HNReader.Core.Models"
    xmlns:converters="using:HNReader.WinUI.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <Grid Padding="32,24,32,24">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="24" Width="600" HorizontalAlignment="Left">

                <!-- Page Header -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" FontWeight="Bold" />
                    <TextBlock Text="Customize your HN Reader experience"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- Appearance -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8"
                        Padding="24">
                    <StackPanel Spacing="20">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="6"
                                    Padding="8">
                                <FontIcon Glyph="&#xE790;" FontSize="16" Foreground="White" />
                            </Border>
                            <TextBlock Text="Appearance" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Theme" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Select your preferred app theme"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1"
                                      MinWidth="140"
                                      SelectedIndex="{Binding SelectedThemeIndex, Mode=TwoWay}"
                                      ItemsSource="{Binding ThemeOptions}"
                                      VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Data -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8"
                        Padding="24">
                    <StackPanel Spacing="20">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="6"
                                    Padding="8">
                                <FontIcon Glyph="&#xE8B7;" FontSize="16" Foreground="White" />
                            </Border>
                            <TextBlock Text="Data" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Backup &amp; restore your favourites"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Export to a JSON file you can save anywhere, or import a previously-exported file."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />

                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                <Button x:Name="ExportFavoritesButton"
                                        Click="ExportFavoritesButton_Click"
                                        Style="{StaticResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE74E;" FontSize="14" />
                                        <TextBlock Text="Export favourites" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ImportFavoritesButton"
                                        Click="ImportFavoritesButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                                        <TextBlock Text="Import favourites" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <InfoBar x:Name="StatusInfoBar"
                                     IsOpen="False"
                                     IsClosable="True"
                                     Margin="0,8,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- About -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8"
                        Padding="24">
                    <StackPanel Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="6"
                                    Padding="8">
                                <FontIcon Glyph="&#xE946;" FontSize="16" Foreground="White" />
                            </Border>
                            <TextBlock Text="About" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <Border Background="#FF6600" CornerRadius="8" Padding="14,12">
                                <TextBlock Text="HN" FontWeight="Bold" FontSize="18" Foreground="White" />
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="HN Reader" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="16" />
                                <TextBlock Text="Version 2.0.0"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="A fast, modern Hacker News reader for Windows. Browse Top/New/Best/Ask/Show stories, read full comment threads, and save your favourites."
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
